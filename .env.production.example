# Copie para .env na raiz do projeto antes do deploy:
#   cp .env.production.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere-senha-forte
POSTGRES_DB=quadro_operacional

# Backend
JWT_SECRET=altere-chave-jwt-longa-e-aleatoria

# Porta pública do app (nginx)
APP_PORT=8080

# Horário de saída dos veículos (coluna SAÍDA no quadro)
SAIDA_VEICULOS_MOCK=true
# SAIDA_VEICULOS_MOCK=false
# SAIDA_VEICULOS_URL=https://seu-sistema-interno.com/programacao-saida
# SAIDA_VEICULOS_SYNC_INTERVAL_MS=60000
