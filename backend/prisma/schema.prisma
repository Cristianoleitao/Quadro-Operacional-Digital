generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  GERENCIA
  PROFISSIONAL
  ESTOQUE
}

enum Setor {
  MEC
  ELE
  LANT
  PINT
  REFR
  BORR
  LIMP
  OUTRO
  PENDENTE
  APS
  CGB
}

model Garagem {
  id        String   @id @default(uuid())
  nome      String
  estado    String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios Usuario[]
  veiculos Veiculo[]

  @@unique([nome, estado])
}

enum StatusServico {
  EM_EXECUCAO
  PARADO_CRITICO
  AGUARDANDO_INSUMO
  SERVICO_DEMORADO
  MANUTENCAO_PREVENTIVA
  SERVICO_EXTERNO
  FINALIZADO
  CONCLUIDO
}

enum TipoChecklist {
  REVISAO_PREVENTIVA
  CHECKLIST_15000
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  matricula     String   @unique
  senha         String
  role          Role
  setor         Setor?
  especialidade String?
  garagemId     String?
  garagem       Garagem? @relation(fields: [garagemId], references: [id])
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  servicos            Servico[] @relation("ServicoProfissional")
  servicosFinalizados Servico[] @relation("ServicoFinalizadoPor")
  participacoes       ServicoParticipante[] @relation("ParticipanteProfissional")
  insumosSolicitados  SolicitacaoInsumo[] @relation("InsumoSolicitadoPor")
  checklistConferidos ServicoChecklistItem[] @relation("ChecklistConferidoPor")
  auditorias Auditoria[]
}

model Veiculo {
  id           String    @id @default(uuid())
  numero       String    @unique
  dataEntrada  DateTime?
  numeroOs     String?
  horaSaida    DateTime?
  garagemId    String?
  garagem      Garagem?  @relation(fields: [garagemId], references: [id])
  fechadoAdmin Boolean   @default(false)
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  servicos      Servico[]
  ordensServico OrdemServico[]
}

model OrdemServico {
  id             String   @id @default(uuid())
  numero         Int      @unique @default(autoincrement())
  veiculoId      String
  veiculo        Veiculo  @relation(fields: [veiculoId], references: [id])
  dataAbertura   DateTime @default(now())
  dataFechamento DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  servicos Servico[]
}

model Servico {
  id             String         @id @default(uuid())
  veiculoId      String
  veiculo        Veiculo        @relation(fields: [veiculoId], references: [id])
  ordemServicoId String?
  ordemServico   OrdemServico?  @relation(fields: [ordemServicoId], references: [id])
  numeroOs       String?
  horaOs         DateTime?
  setor          Setor
  tipoChecklist  TipoChecklist?
  descricao      String
  localExterno   String?
  status         StatusServico @default(EM_EXECUCAO)
  profissionalId String?
  profissional   Usuario?      @relation("ServicoProfissional", fields: [profissionalId], references: [id])
  finalizadoPorId String?
  finalizadoPor   Usuario?      @relation("ServicoFinalizadoPor", fields: [finalizadoPorId], references: [id])
  horaAssumido   DateTime?
  horaInicio     DateTime?
  horaTermino    DateTime?
  tempoTotalMin  Int?
  pausadoEm      DateTime?
  minutosPausadosAcum Int @default(0)
  correcao       String?
  correcaoAudio  String?
  fotoAntes      String?
  fotoDepois     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  insumos       SolicitacaoInsumo[]
  participantes ServicoParticipante[]
  checklistItens ServicoChecklistItem[]
}

/** Itens da revisão / checklist 15.000 — visíveis só ao profissional do setor. */
model ServicoChecklistItem {
  id             String    @id @default(uuid())
  servicoId      String
  servico        Servico   @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  setor          Setor
  ordem          Int
  descricao      String
  quantidade     Int       @default(1)
  conferido      Boolean   @default(false)
  conferidoEm    DateTime?
  conferidoPorId String?
  conferidoPor   Usuario?  @relation("ChecklistConferidoPor", fields: [conferidoPorId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([servicoId, setor])
}

/** Alocação N:N para revisão preventiva (REV / OUTRO). */
model ServicoParticipante {
  id                  String    @id @default(uuid())
  servicoId           String
  servico             Servico   @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  profissionalId      String
  profissional        Usuario   @relation("ParticipanteProfissional", fields: [profissionalId], references: [id])
  horaAssumido        DateTime  @default(now())
  horaInicio          DateTime?
  horaTermino         DateTime?
  pausadoEm           DateTime?
  minutosPausadosAcum Int       @default(0)
  obs                 String?
  correcao            String?
  tempoTotalMin       Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([servicoId, profissionalId])
  @@index([profissionalId, horaTermino])
}

model SolicitacaoInsumo {
  id        String   @id @default(uuid())
  servicoId String
  servico   Servico  @relation(fields: [servicoId], references: [id])
  descricao String
  quantidade Int     @default(1)
  posicao    String?
  atendido  Boolean  @default(false)
  aguardarPeca Boolean @default(false)
  solicitadoPorId String?
  solicitadoPor   Usuario? @relation("InsumoSolicitadoPor", fields: [solicitadoPorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Auditoria {
  id         String   @id @default(uuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId String?
  detalhes   Json?
  createdAt  DateTime @default(now())
}

