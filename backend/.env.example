DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quadro_operacional?schema=public"
JWT_SECRET="altere-esta-chave-em-producao"
PORT=3001
UPLOAD_DIR="./uploads"

# Horário de saída (coluna SAÍDA — somente corretiva)
# Modo teste: mock JSON local
SAIDA_VEICULOS_MOCK=true
# SAIDA_VEICULOS_MOCK_PATH="./data/saida-veiculos-mock.json"

# Modo produção: acessa o SITE (HTML), cruza carros do quadro com a página
# SAIDA_VEICULOS_MOCK=false
# SAIDA_VEICULOS_URL="https://seu-sistema-interno.com/programacao-saida"
# SAIDA_VEICULOS_SYNC_INTERVAL_MS=60000
# SAIDA_VEICULOS_TIMEOUT_MS=15000
# SAIDA_VEICULOS_SITE_USER_AGENT="QuadroOperacional/1.0"

# Testar parser HTML sem site real (usa arquivo local):
# SAIDA_VEICULOS_MOCK=false
# SAIDA_VEICULOS_URL="fixture:./data/saida-veiculos-site-exemplo.html"
# SAIDA_VEICULOS_SITE_FIXTURE_PATH="./data/saida-veiculos-site-exemplo.html"
